# ---------------------------------------------------------
# Environment files - never commit real secrets
# ---------------------------------------------------------
.env
.env.*
!.env.example
backend/.env
frontend/.env

# ---------------------------------------------------------
# Node / JavaScript
# ---------------------------------------------------------
node_modules/
backend/node_modules/
frontend/node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ---------------------------------------------------------
# Frontend build output
# ---------------------------------------------------------
frontend/dist/
frontend/build/

# ---------------------------------------------------------
# Terraform
# ---------------------------------------------------------
**/.terraform/

# Keep .terraform.lock.hcl committed for reproducible builds
# DO NOT ignore .terraform.lock.hcl

# Terraform state files - never commit
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!example.tfvars

# Terraform plan files - never commit
*.tfplan
*.tfplan.json

# Terraform crash/debug files
crash.log
crash.*.log

# Terraform CLI configuration
.terraformrc
terraform.rc

# ---------------------------------------------------------
# Docker
# ---------------------------------------------------------
*.pid

# ---------------------------------------------------------
# Kubernetes / kubeconfig
# Never commit cluster credentials or local secrets
# ---------------------------------------------------------
kubeconfig
kubeconfig.yaml
*.kubeconfig

**/k8s/**/*-secret.yaml.local

# ---------------------------------------------------------
# CI / SonarQube local artifacts
# ---------------------------------------------------------
.scannerwork/
.sonar/

# ---------------------------------------------------------
# AWS
# ---------------------------------------------------------
.aws/

# AWS Load Balancer Controller policy downloaded locally
iam_policy.json

# ---------------------------------------------------------
# OS / Editor
# ---------------------------------------------------------
.DS_Store
Thumbs.db

.vscode/
.idea/
*.swp
